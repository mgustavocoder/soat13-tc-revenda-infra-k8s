region                  = "us-east-1"
project_name            = "soat13-tc-revenda"
cluster_name            = "soat13-tc-revenda"
kubernetes_version      = "1.32"
kubectl_cidr_allowlist  = ["REPLACE_WITH_YOUR_PUBLIC_IP/32"]
node_instance_type      = "t3.medium"
desired_nodes           = 2
min_nodes               = 2
max_nodes               = 4
# Leave empty on the first apply. Set the internal ALB listener ARN after ingress exists.
load_balancer_listener_arn = ""
